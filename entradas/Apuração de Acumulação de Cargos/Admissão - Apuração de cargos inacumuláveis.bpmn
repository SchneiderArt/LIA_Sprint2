    <task id="Id_cec49427-8ed9-4bf6-956a-014aeb5a5abd" name="Verificar se o(a) servidor(a) possui outro(s) vínculo(s) além da UFMS">
      <documentation>&lt;p style="text-align:left;text-indent:0pt;margin:0pt 0pt 0pt 0pt;"&gt;&lt;span style="color:#000000;background-color:transparent;font-family:'Segoe UI';font-size:8pt;font-weight:normal;font-style:normal;"&gt;Consultar a Rela&amp;ccedil;&amp;atilde;o Anual de Informa&amp;ccedil;&amp;otilde;es Sociais (Rais), o Cadastro Nacional de Estabelecimento de Sa&amp;uacute;de (Cnes), o Portal da Transpar&amp;ecirc;ncia CGU e Siape. Verificar os documentos no processo caso haja comprova&amp;ccedil;&amp;atilde;o de desligamento/exonera&amp;ccedil;&amp;atilde;o.&lt;/span&gt;&lt;/p&gt;</documentation>
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
