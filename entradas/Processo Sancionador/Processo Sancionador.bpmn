        </bizagi:BizagiExtensions>
      </extensionElements>
    </sequenceFlow>
    <textAnnotation id="Id_c47b3b61-dd6b-4b21-888b-d06cf6cae57b">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Conferência do instrumento jurídico apenso, cobranças e dados da empresa</text>
    </textAnnotation>
    <textAnnotation id="Id_47670048-0913-46e4-a61d-22b4779d3eb6">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Relacionar novo processo aos autos do contrato original</text>
    </textAnnotation>
    <textAnnotation id="Id_8e237e3b-0b0a-4835-890d-0acde30f8e5e">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Contém razão social, CNPJ e número do processo</text>
    </textAnnotation>
    <textAnnotation id="Id_25db29e2-2257-4f1a-8a67-45136860f83b">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Explicita prazo de 5 dias úteis a partir do recebimento, razões e rol de punições previstas em lei</text>
    </textAnnotation>
    <textAnnotation id="Id_e43a0677-9a76-4294-9415-5f4a64187e01">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Contagem dos dias úteis a partir do subsequente à data do Aviso de Recebimento</text>
    </textAnnotation>
    <textAnnotation id="Id_74b1f88d-87c9-4b90-98d4-e555e958af69">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Informar autorização do solicitado em defesa e prazo para atendimento</text>
    </textAnnotation>
    <textAnnotation id="Id_4385c644-ae79-42c7-b496-d53b4eae61fa">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Informar Decisão de penalidade e prazo recursal de 5 dias úteis</text>
    </textAnnotation>
    <textAnnotation id="Id_d8e4bbed-8254-4fbd-8f22-f6e0fad52c32">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Origem dos valores, correção, vencimento e memorial de cálculo</text>
    </textAnnotation>
    <textAnnotation id="Id_66b08176-92e2-4aa7-9ef2-0f76b5d57bf1">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Contém previsão de inscrição no CADIN, dívida ativa e cobrança judicial</text>
    </textAnnotation>
    <textAnnotation id="Id_cdeb210a-f4e4-411a-8a48-1592ef65cd5b">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="borderColor" value="#D5D5D5" />
            <bizagi:BizagiProperty name="textColor" value="#000000" />
            <bizagi:BizagiProperty name="textBackgroundColor" value="Transparent" />
            <bizagi:BizagiProperty name="textDirection" value="" />
          </bizagi:BizagiProperties>
        </bizagi:BizagiExtensions>
      </extensionElements>
      <text>Possibilidade de requerer parcelamento ou novo prazo</text>
    </textAnnotation>
    <textAnnotation id="Id_0be380ff-5455-4075-a70c-99dfcf9fd247">
      <documentation />
      <extensionElements>
        <bizagi:BizagiExtensions xmlns:bizagi="http://www.bizagi.com/bpmn20">
          <bizagi:BizagiProperties>
            <bizagi:BizagiProperty name="bgColor" value="#D5D5D5" />
